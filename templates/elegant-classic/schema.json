{
  "id": "elegant-classic",
  "name": "우아한 클래식",
  "description": "클래식한 세로 스크롤 청첩장",
  "version": "1.0.0",
  "thumbnail": "thumbnail.svg",
  "interaction": "scroll",
  "sections": {
    "available": ["hero", "greeting", "gallery", "info", "guestbook", "rsvp"],
    "defaultOrder": ["hero", "greeting", "gallery", "info", "guestbook", "rsvp"],
    "required": ["hero", "info"]
  },
  "fields": {
    "기본 정보": {
      "groomName": { "type": "text", "label": "신랑 이름", "required": true, "placeholder": "김민수" },
      "brideName": { "type": "text", "label": "신부 이름", "required": true, "placeholder": "이수진" },
      "weddingDate": { "type": "datetime", "label": "예식 일시", "required": true },
      "greeting": { "type": "textarea", "label": "인사말", "maxLength": 500, "placeholder": "서로 다른 계절을 걷던 두 사람이 하나의 시간으로 만납니다." },
      "heroImage": { "type": "image", "label": "대표 사진", "accept": ["jpg", "png", "webp"], "maxSize": "10MB" },
      "couplePhoto": { "type": "image", "label": "커플 사진 (선택)", "accept": ["jpg", "png", "webp"], "maxSize": "10MB" }
    },
    "갤러리": {
      "photos": { "type": "image[]", "label": "갤러리 사진", "min": 0, "max": 20, "description": "최대 20장, 각 10MB 이하" }
    },
    "예식 정보": {
      "venue": { "type": "text", "label": "예식장 이름", "placeholder": "그랜드볼룸" },
      "address": { "type": "text", "label": "주소", "placeholder": "서울 강남구 테헤란로 1" },
      "mapType": {
        "type": "select",
        "label": "지도 유형",
        "options": [
          { "value": "kakao", "label": "카카오맵" },
          { "value": "naver", "label": "네이버지도" },
          { "value": "none", "label": "지도 없음" }
        ]
      },
      "mapCoords": { "type": "latlng", "label": "좌표" },
      "transport": { "type": "textarea", "label": "교통 안내" },
      "parking": { "type": "text", "label": "주차 안내" }
    },
    "방명록 & RSVP": {
      "guestbookUrl": { "type": "url", "label": "방명록 GAS URL", "validate": "ping", "description": "구글 앱 스크립트 웹 앱 URL" },
      "rsvpUrl": { "type": "url", "label": "RSVP GAS URL", "validate": "ping" },
      "rsvpFields": {
        "type": "select[]",
        "label": "RSVP 수집 항목",
        "options": [
          { "value": "name", "label": "이름" },
          { "value": "attending", "label": "참석 여부" },
          { "value": "guests", "label": "동행 인원" },
          { "value": "meal", "label": "식사 여부" },
          { "value": "message", "label": "한마디" }
        ]
      }
    },
    "스타일": {
      "colorScheme": { "type": "select", "label": "색상 테마", "optionsFrom": "style.colorSchemes" },
      "fontSourceMode": {
        "type": "select",
        "label": "폰트 설정 방식",
        "options": [
          { "value": "preset", "label": "추천 조합 사용" },
          { "value": "custom", "label": "직접 입력" }
        ],
        "description": "추천 조합을 쓰거나, 구글 폰트 CSS URL과 family를 직접 넣을 수 있습니다."
      },
      "headingFont": {
        "type": "select",
        "label": "제목 폰트",
        "optionsFrom": "style.headingFonts",
        "visibleWhen": { "field": "fontSourceMode", "equals": "preset" }
      },
      "bodyFont": {
        "type": "select",
        "label": "본문 폰트",
        "optionsFrom": "style.bodyFonts",
        "visibleWhen": { "field": "fontSourceMode", "equals": "preset" }
      },
      "googleFontUrl": {
        "type": "url",
        "label": "구글 폰트 CSS URL",
        "placeholder": "https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Inter:wght@400;500;700&display=swap",
        "description": "fonts.googleapis.com/css2 형식의 URL을 넣어 주세요.",
        "visibleWhen": { "field": "fontSourceMode", "equals": "custom" }
      },
      "customHeadingFamily": {
        "type": "text",
        "label": "제목 font-family",
        "placeholder": "\"Playfair Display\", serif",
        "visibleWhen": { "field": "fontSourceMode", "equals": "custom" }
      },
      "customBodyFamily": {
        "type": "text",
        "label": "본문 font-family",
        "placeholder": "Inter, sans-serif",
        "visibleWhen": { "field": "fontSourceMode", "equals": "custom" }
      },
      "animation": {
        "type": "select",
        "label": "애니메이션 스타일",
        "options": [
          { "value": "fade", "label": "페이드 인" },
          { "value": "slide", "label": "슬라이드 업" },
          { "value": "none", "label": "없음" }
        ]
      },
      "bgMusic": { "type": "file", "label": "배경음악 (선택)", "accept": ["mp3", "ogg"], "maxSize": "5MB" }
    }
  },
  "style": {
    "colorSchemes": [
      { "value": "warm-blush", "label": "웜 블러시", "primary": "#b97a56", "bg": "#f7f0e6" },
      { "value": "classic-navy", "label": "클래식 네이비", "primary": "#1d3557", "bg": "#f1f5f9" },
      { "value": "sage-green", "label": "세이지 그린", "primary": "#5d7052", "bg": "#f7f4ea" }
    ],
    "headingFonts": [
      {
        "value": "gowun-batang",
        "label": "고운바탕",
        "provider": "google",
        "importUrl": "https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&display=swap",
        "family": "\"Gowun Batang\", \"Noto Serif KR\", serif",
        "previewText": "단정한 여백과 고전적인 분위기"
      },
      {
        "value": "song-myung",
        "label": "송명",
        "provider": "google",
        "importUrl": "https://fonts.googleapis.com/css2?family=Song+Myung&display=swap",
        "family": "\"Song Myung\", \"Noto Serif KR\", serif",
        "previewText": "격식 있는 세리프와 잔잔한 존재감"
      },
      {
        "value": "noto-serif-kr",
        "label": "노토세리프 KR",
        "provider": "google",
        "importUrl": "https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;500;600;700&display=swap",
        "family": "\"Noto Serif KR\", serif",
        "previewText": "안정적이고 고급스러운 한글 세리프"
      },
      {
        "value": "nanum-myeongjo",
        "label": "나눔명조",
        "provider": "google",
        "importUrl": "https://fonts.googleapis.com/css2?family=Nanum+Myeongjo:wght@400;700;800&display=swap",
        "family": "\"Nanum Myeongjo\", serif",
        "previewText": "정통 청첩장 감성의 또렷한 명조"
      }
    ],
    "bodyFonts": [
      {
        "value": "noto-sans-kr",
        "label": "노토산스 KR",
        "provider": "google",
        "importUrl": "https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap",
        "family": "\"Noto Sans KR\", sans-serif",
        "previewText": "또렷하고 가장 무난한 본문용 산세리프"
      },
      {
        "value": "gowun-dodum",
        "label": "고운돋움",
        "provider": "google",
        "importUrl": "https://fonts.googleapis.com/css2?family=Gowun+Dodum&display=swap",
        "family": "\"Gowun Dodum\", \"Noto Sans KR\", sans-serif",
        "previewText": "부드럽고 덜 딱딱한 본문 인상"
      },
      {
        "value": "nanum-gothic",
        "label": "나눔고딕",
        "provider": "google",
        "importUrl": "https://fonts.googleapis.com/css2?family=Nanum+Gothic:wght@400;700;800&display=swap",
        "family": "\"Nanum Gothic\", sans-serif",
        "previewText": "안정적인 정보 전달에 강한 기본체"
      },
      {
        "value": "ibm-plex-sans-kr",
        "label": "IBM Plex Sans KR",
        "provider": "google",
        "importUrl": "https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@400;500;700&display=swap",
        "family": "\"IBM Plex Sans KR\", sans-serif",
        "previewText": "정제되고 현대적인 본문 톤"
      }
    ],
    "animations": [
      { "value": "fade", "label": "페이드 인" },
      { "value": "slide", "label": "슬라이드 업" },
      { "value": "none", "label": "없음" }
    ]
  },
  "i18n": {
    "defaultLocale": "ko",
    "supported": ["ko"]
  }
}
