{
  "id": "cinematic-scroll",
  "name": "시네마틱 스크롤",
  "description": "풀스크린 이미지와 패럴랙스 감성의 시네마틱 청첩장",
  "version": "1.0.0",
  "thumbnail": "thumbnail.svg",
  "interaction": "parallax",
  "sections": {
    "available": ["hero", "greeting", "gallery", "info", "guestbook", "rsvp"],
    "defaultOrder": ["hero", "gallery", "greeting", "schedule", "location", "family", "guestbook", "account", "ending"],
    "required": ["hero", "info"]
  },
  "fields": {
    "기본 정보": {
      "groomName": { "type": "text", "label": "신랑 이름", "required": true },
      "brideName": { "type": "text", "label": "신부 이름", "required": true },
      "weddingDate": { "type": "datetime", "label": "예식 일시", "required": true },
      "greeting": { "type": "textarea", "label": "인사말", "maxLength": 500 },
      "heroImage": { "type": "image", "label": "대표 사진", "accept": ["jpg", "png", "webp"], "maxSize": "10MB" },
      "couplePhoto": { "type": "image", "label": "커플 사진 (선택)", "accept": ["jpg", "png", "webp"], "maxSize": "10MB" }
    },
    "갤러리": {
      "photos": { "type": "image[]", "label": "갤러리 사진", "min": 0, "max": 20 }
    },
    "예식 정보": {
      "venue": { "type": "text", "label": "예식장 이름" },
      "address": { "type": "text", "label": "주소" },
      "mapType": {
        "type": "select",
        "label": "지도 유형",
        "options": [
          { "value": "kakao", "label": "카카오맵" },
          { "value": "naver", "label": "네이버지도" },
          { "value": "none", "label": "지도 없음" }
        ]
      },
      "mapCoords": { "type": "latlng", "label": "좌표" },
      "transport": { "type": "textarea", "label": "교통 안내" },
      "parking": { "type": "text", "label": "주차 안내" }
    },
    "방명록 & RSVP": {
      "guestbookUrl": { "type": "url", "label": "방명록 GAS URL", "validate": "ping" },
      "rsvpUrl": { "type": "url", "label": "RSVP GAS URL", "validate": "ping" },
      "rsvpFields": {
        "type": "select[]",
        "label": "RSVP 수집 항목",
        "options": [
          { "value": "name", "label": "이름" },
          { "value": "attending", "label": "참석 여부" },
          { "value": "guests", "label": "동행 인원" },
          { "value": "meal", "label": "식사 여부" },
          { "value": "message", "label": "한마디" }
        ]
      }
    },
    "스타일": {
      "colorScheme": { "type": "select", "label": "색상 테마", "optionsFrom": "style.colorSchemes" },
      "fontSourceMode": {
        "type": "select",
        "label": "폰트 설정 방식",
        "options": [
          { "value": "preset", "label": "추천 조합 사용" },
          { "value": "custom", "label": "직접 입력" }
        ]
      },
      "headingFont": {
        "type": "select",
        "label": "제목 폰트",
        "optionsFrom": "style.headingFonts",
        "visibleWhen": { "field": "fontSourceMode", "equals": "preset" }
      },
      "bodyFont": {
        "type": "select",
        "label": "본문 폰트",
        "optionsFrom": "style.bodyFonts",
        "visibleWhen": { "field": "fontSourceMode", "equals": "preset" }
      },
      "googleFontUrl": {
        "type": "url",
        "label": "구글 폰트 CSS URL",
        "placeholder": "https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Inter:wght@400;500;700&display=swap",
        "visibleWhen": { "field": "fontSourceMode", "equals": "custom" }
      },
      "customHeadingFamily": {
        "type": "text",
        "label": "제목 font-family",
        "placeholder": "\"Playfair Display\", serif",
        "visibleWhen": { "field": "fontSourceMode", "equals": "custom" }
      },
      "customBodyFamily": {
        "type": "text",
        "label": "본문 font-family",
        "placeholder": "Inter, sans-serif",
        "visibleWhen": { "field": "fontSourceMode", "equals": "custom" }
      },
      "animation": {
        "type": "select",
        "label": "애니메이션 스타일",
        "options": [
          { "value": "slide", "label": "패럴랙스 스크롤" },
          { "value": "fade", "label": "페이드 인" },
          { "value": "none", "label": "없음" }
        ]
      },
      "bgMusic": { "type": "file", "label": "배경음악 (선택)", "accept": ["mp3", "ogg"], "maxSize": "5MB" }
    }
  },
  "style": {
    "colorSchemes": [
      { "value": "midnight", "label": "미드나이트", "primary": "#d4a373", "bg": "#121417" },
      { "value": "moonlight", "label": "문라이트", "primary": "#e7cba9", "bg": "#1e242c" }
    ],
    "headingFonts": [
      {
        "value": "song-myung",
        "label": "송명",
        "provider": "google",
        "importUrl": "https://fonts.googleapis.com/css2?family=Song+Myung&display=swap",
        "family": "\"Song Myung\", \"Noto Serif KR\", serif"
      },
      {
        "value": "noto-serif-kr",
        "label": "노토세리프 KR",
        "provider": "google",
        "importUrl": "https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;500;600;700&display=swap",
        "family": "\"Noto Serif KR\", serif"
      },
      {
        "value": "gowun-batang",
        "label": "고운바탕",
        "provider": "google",
        "importUrl": "https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&display=swap",
        "family": "\"Gowun Batang\", \"Noto Serif KR\", serif"
      }
    ],
    "bodyFonts": [
      {
        "value": "ibm-plex-sans-kr",
        "label": "IBM Plex Sans KR",
        "provider": "google",
        "importUrl": "https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@400;500;700&display=swap",
        "family": "\"IBM Plex Sans KR\", sans-serif"
      },
      {
        "value": "noto-sans-kr",
        "label": "노토산스 KR",
        "provider": "google",
        "importUrl": "https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap",
        "family": "\"Noto Sans KR\", sans-serif"
      },
      {
        "value": "gowun-dodum",
        "label": "고운돋움",
        "provider": "google",
        "importUrl": "https://fonts.googleapis.com/css2?family=Gowun+Dodum&display=swap",
        "family": "\"Gowun Dodum\", \"Noto Sans KR\", sans-serif"
      }
    ],
    "animations": [
      { "value": "slide", "label": "패럴랙스 스크롤" },
      { "value": "fade", "label": "페이드 인" },
      { "value": "none", "label": "없음" }
    ]
  },
  "i18n": {
    "defaultLocale": "ko",
    "supported": ["ko"]
  }
}
